#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JOB_UTILS_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
if [ ! -x "$JOB_UTILS_ROOT/.venv/bin/python" ]; then
  echo "jobutils-vim: run scripts/setup.sh first" >&2
  exit 1
fi
if [ -n "${PYTHONPATH:-}" ]; then
  PYTHONPATH="$JOB_UTILS_ROOT/src:$PYTHONPATH"
else
  PYTHONPATH="$JOB_UTILS_ROOT/src"
fi
export PYTHONPATH
if ! command -v vim >/dev/null 2>&1; then
  echo "jobutils-vim: Vim was not found" >&2
  exit 127
fi
if [ "$#" -eq 0 ]; then
  if [ -n "${GTD_ROOT:-}" ] && [ -f "$GTD_ROOT/gtd.md" ]; then
    set -- "$GTD_ROOT/gtd.md"
  elif [ -f "gtd.md" ]; then
    set -- "gtd.md"
  fi
fi
exec vim "$@"
