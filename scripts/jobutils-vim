#!/bin/sh

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JOB_UTILS_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
if [ ! -x "$JOB_UTILS_ROOT/.venv/bin/python" ]; then
  echo "jobutils-vim: run scripts/setup.sh first" >&2
  exit 1
fi
if ! command -v vim >/dev/null 2>&1; then
  echo "jobutils-vim: Vim was not found" >&2
  exit 127
fi
exec vim "$@"
