#!/bin/sh
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -n "${PYTHONPATH:-}" ]; then
  PYTHONPATH="$SCRIPT_DIR/../src:$PYTHONPATH"
else
  PYTHONPATH="$SCRIPT_DIR/../src"
fi
export PYTHONPATH
if [ -n "${JOBUTILS_PYTHON:-}" ]; then
  python_command="$JOBUTILS_PYTHON"
elif command -v python >/dev/null 2>&1; then
  python_command=python
elif command -v python3 >/dev/null 2>&1; then
  python_command=python3
else
  echo "jobutils: Python 3 was not found" >&2
  exit 127
fi
if ! "$python_command" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
  echo "jobutils: Python 3.8 or newer is required" >&2
  exit 1
fi
exec "$python_command" -m jobutils "$@"
