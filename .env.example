# Copy this file to .env locally. The setup command prompts for these values.
# JIRA_API_TOKEN and CONFLUENCE_API_TOKEN are secret values; never commit .env
# or paste token values into Markdown, plans, logs, or reports.

JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=YOUR_ATLASSIAN_EMAIL
JIRA_API_TOKEN=
JIRA_PROJECT=LIG
JIRA_ISSUE_TYPE=Task
# Optional custom field used by published task Markdown.
JIRA_PROGRESS_COMMENT_FIELD=
# Use text for a single-line text field, or adf for a textarea field.
JIRA_PROGRESS_COMMENT_FORMAT=text

CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
CONFLUENCE_EMAIL=YOUR_ATLASSIAN_EMAIL
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_ID=163844
CONFLUENCE_SPACE_KEY=KB
CONFLUENCE_PARENT_ID=210632708
